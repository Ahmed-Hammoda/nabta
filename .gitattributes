# Normalise text files; the Pi needs Linux line endings
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.json text eol=lf

# Binary and CAD files: store as is, no text diff
*.step binary
*.stl binary
*.dxf -diff
*.psd binary
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.zip binary

# Keep GitHub's language bar about the code, not the HTML pages
docs/** linguist-documentation
