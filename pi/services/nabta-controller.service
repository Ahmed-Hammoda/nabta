[Unit]
Description=Nabta controller (rules v2 decision + message, logs/<YYYY-MM>/decisions.csv)
After=nabta-logger.service ollama.service
Wants=nabta-logger.service

[Service]
User=footsteps
WorkingDirectory=/home/footsteps/nabta
ExecStart=/usr/bin/python3 -u /home/footsteps/nabta/nabta_controller.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
